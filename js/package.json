{
  "name": "@conao3/wasmo",
  "version": "0.1.1",
  "description": "Stateful in-process AWS mock for the AWS SDK for JavaScript v3, powered by a single WebAssembly module",
  "keywords": [
    "aws",
    "aws-sdk",
    "mock",
    "testing",
    "webassembly",
    "wasm",
    "s3",
    "dynamodb",
    "sqs",
    "localstack"
  ],
  "author": "conao3",
  "license": "Apache-2.0",
  "homepage": "https://github.com/conao3/wasm-wasmo/tree/main/js#readme",
  "bugs": {
    "url": "https://github.com/conao3/wasm-wasmo/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/conao3/wasm-wasmo.git",
    "directory": "js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "wasmo.wasm",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --test test/*.test.ts",
    "test:bun": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "tsc -p ."
  },
  "dependencies": {
    "@smithy/types": "^4.19.0"
  },
  "devDependencies": {
    "@aws-sdk/client-api-gateway": "^3.1159.0",
    "@aws-sdk/client-apigatewayv2": "^3.1159.0",
    "@aws-sdk/client-cloudwatch": "^3.1159.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.1159.0",
    "@aws-sdk/client-dynamodb": "^3.1159.0",
    "@aws-sdk/client-dynamodb-streams": "^3.1159.0",
    "@aws-sdk/client-eventbridge": "^3.1159.0",
    "@aws-sdk/client-firehose": "^3.1159.0",
    "@aws-sdk/client-iam": "^3.1159.0",
    "@aws-sdk/client-kinesis": "^3.1159.0",
    "@aws-sdk/client-kms": "^3.1159.0",
    "@aws-sdk/client-lambda": "^3.1159.0",
    "@aws-sdk/client-s3": "^3.1159.0",
    "@aws-sdk/client-secrets-manager": "^3.1159.0",
    "@aws-sdk/client-sfn": "^3.1159.0",
    "@aws-sdk/client-sns": "^3.1159.0",
    "@aws-sdk/client-sqs": "^3.1159.0",
    "@aws-sdk/client-ssm": "^3.1159.0",
    "@aws-sdk/client-sts": "^3.1159.0",
    "@aws-sdk/lib-dynamodb": "^3.1159.0",
    "@aws-sdk/lib-storage": "^3.1159.0",
    "@types/node": "^20.19.43",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
